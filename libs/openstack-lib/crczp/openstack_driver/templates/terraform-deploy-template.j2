{%- set tf_resource_instance = "openstack_compute_instance_v2" -%}
{%- set tf_resource_network = "openstack_networking_network_v2" -%}
{%- set tf_resource_subnet = "openstack_networking_subnet_v2" -%}
{%- set tf_resource_port = "openstack_networking_port_v2" -%}
{%- set tf_secgroup = "openstack_networking_secgroup_v2" -%}
{%- set tf_secgroup_rule = "openstack_networking_secgroup_rule_v2" -%}

{%- set tf_provider = "openstack" -%}
{%- set tf_provider_source = "terraform-provider-openstack/openstack" -%}

{%- set hosts_names = topology_instance.get_hosts() | map(attribute='name') | list -%}
{%- set man = topology_instance.man -%}
{%- set key_pair_names_dict = {
    protocol.SSH: key_pair_name_ssh,
    protocol.WINRM: key_pair_name_cert,
} -%}


{%- macro tf_network(name, admin_state_up=true) %}
resource "{{ tf_resource_network }}" "{{ name }}" {
    name = "{{ name }}"
    admin_state_up = "{{ (admin_state_up | string).lower() }}"
}

{%- endmacro -%}


{%- macro tf_subnet(name, network_name, cidr, gateway_ip, dns_name_servers=[]) %}
resource "{{ tf_resource_subnet }}" "{{ name }}" {
    name = "{{ name }}"
    network_id = {{ tf_resource_network + '.' + network_name }}.id
    cidr = "{{ cidr }}"
{%- if gateway_ip %}
    gateway_ip = "{{ gateway_ip }}"
{%- else %}
    no_gateway = "true"
{%- endif %}
    dns_nameservers = [
    {%- for server in dns_name_servers %}
        "{{ server }}",
    {%- endfor %}
    ]
}
{%- endmacro -%}


{%- macro tf_port(name, network_name, security_group_name, fixed_ip, subnet_name,
                  allowed_address_pairs=false, admin_state_up=true, security_group_ref=none) %}
resource "{{ tf_resource_port }}" "{{ name }}" {
    name = "{{ name }}"
{%- if network_name == trc.base_network %}
    network_id = data.{{ tf_resource_network + '.' + network_name }}.id
{%- else %}
    network_id = {{ tf_resource_network + '.' + network_name }}.id
{%- endif %}
    admin_state_up = "{{ (admin_state_up | string).lower() }}"
    security_group_ids = [
{%- if security_group_ref %}
        {{ security_group_ref }}
{%- else %}
        data.{{ tf_secgroup + '.' + security_group_name}}.id
{%- endif %}
    ]
{% if subnet_name %}
    fixed_ip {
        subnet_id = {{ tf_resource_subnet + '.' + subnet_name }}.id
    {%- if fixed_ip is not none %}
        ip_address = "{{ fixed_ip }}"
    {%- endif %}
    }
{% endif %}
    allowed_address_pairs {
    {%- if allowed_address_pairs %}
        ip_address = {{ tf_resource_subnet + '.' + subnet_name }}.cidr
    {%- else %}
        ip_address = "0.0.0.0/0"
    {%- endif %}
    }
}
{%- endmacro -%}

{%- macro tf_instance(name, image_name, flavor_name, key_pair, link_names, volumes=[]) %}
{%- if not volumes %}
data "openstack_images_image_ids_v2" "image_data_source-{{ name }}" {
  name = "{{ image_name }}"
}
{%- else %}
{%- for volume in volumes %}
{%- set eff_image = volume.image if volume.image is not none else (image_name if loop.first else none) %}
{%- if eff_image is not none %}
data "openstack_images_image_ids_v2" "image_data_source-{{ name }}-{{ loop.index0 }}" {
  name = "{{ eff_image }}"
}
{%- endif %}
{%- endfor %}
{%- endif %}

resource "{{ tf_resource_instance }}" "{{ name }}" {
    name = "{{ name }}"
{%- if not volumes %}
    image_name = "{{ image_name }}"
{%- endif %}
    flavor_name = "{{ flavor_name }}"
    key_pair = "{{ key_pair }}"
    config_drive = "true"
{% if volumes %}
{%- for volume in volumes %}
{%- set eff_image = volume.image if volume.image is not none else (image_name if loop.first else none) %}
    block_device {
{%- if eff_image is not none %}
        uuid                  = data.openstack_images_image_ids_v2.image_data_source-{{ name }}-{{ loop.index0 }}.ids[0]
        source_type           = "image"
{%- else %}
        source_type           = "blank"
{%- endif %}
        destination_type      = "volume"
        boot_index            = {{ 0 if loop.first else -1 }}
        volume_size           = {{ volume.size }}
        delete_on_termination = true
    }
{%- endfor %}
{%- endif %}
{% for link_name in link_names %}
    network {
        port = {{ tf_resource_port + '.' + link_name }}.id
    }
{% endfor -%}
}
{% endmacro -%}

data "{{ tf_resource_network }}" "{{ trc.base_network }}" {
    name = "{{ trc.base_network }}"
}

{%- if True %}
{% for group in security_groups %}
data "{{ tf_secgroup }}" "{{ group.value }}" {
    name = "{{ group.value }}"
}
{% endfor -%}

{% endif %}

{%- for network in topology_instance.get_networks() -%}
    {%- set default_gateway = topology_instance.get_network_default_gateway_link(network) -%}
    {%- set network_name = resource_prefix ~ '-' ~ network.name -%}
    {%- set subnet_name = network_name ~ '-subnet' -%}
    {%- set dns_name_servers = trc.dns_name_servers -%}
    {{ tf_network(network_name) }}
    {{ tf_subnet(subnet_name, network_name, network.cidr, default_gateway.ip,
                 dns_name_servers) }}

    {%- for link in topology_instance.get_network_links(network) -%}
        {%- set link_name = resource_prefix ~ '-' ~ link.name -%}
        {#- A mirror destination is exposed by a floating IP, so it drops the topology security
            group for one that admits the hypervisors only. -#}
        {%- set secgroup_ref = (tf_secgroup ~ '.' ~ tap_mirror_plan.secgroup_name ~ '.id')
                               if link_name in tap_mirror_plan.destination_port_names else none -%}
        {%- if network == topology_instance.man_network and link.node.name == man.name %}
            {# Allow any source IP on MAN's management interface to enable VPN traffic to relay server -#}
            {{ tf_port(link_name, network_name, link.security_group, link.ip, subnet_name,
                       allowed_address_pairs=false, security_group_ref=secgroup_ref) }}
        {%- elif link.node.name in hosts_names or network == topology_instance.man_network %}
            {{ tf_port(link_name, network_name, link.security_group, link.ip, subnet_name,
                       allowed_address_pairs=true, security_group_ref=secgroup_ref) }}
        {%- else %}
            {{ tf_port(link_name, network_name, link.security_group, link.ip, subnet_name,
                       allowed_address_pairs=false, security_group_ref=secgroup_ref) }}
        {%- endif %}
    {%- endfor %}
{% endfor -%}

{%- for node in topology_instance.get_nodes_without_man() %}
    {%- set node_name = resource_prefix ~ '-' ~ node.name -%}
    {%- set link_names = topology_instance.get_node_links(node) | map(attribute = 'name')
                         | map('regex_replace', '^', resource_prefix ~ '-') | list -%}

    {{ tf_instance(node_name, node.base_box.image, node.flavor,
                   key_pair_names_dict[node.base_box.mgmt_protocol], link_names, node.volumes) }}
{% endfor %}

{%- set man_out_port_name = resource_prefix ~ '-' ~ trc.man_out_port -%}

{{ tf_port(man_out_port_name, trc.base_network, security_groups.SANDBOX_ACCESS.value) }}
{% if True -%}

    {%- set man_name = resource_prefix ~ '-' ~ man.name %}
    {%- set man_links = topology_instance.get_node_links(topology_instance.man) -%}
    {%- set man_link_names = [man_out_port_name] + (man_links | map(attribute='name')
                             | map('regex_replace', '^', resource_prefix ~ '-') | list) -%}
    {{ tf_instance(man_name, man.base_box.image, man.flavor, key_pair_name_ssh, man_link_names) }}
{%- endif -%}

{#- Network forwarding (port mirroring) via OVN Tap-as-a-Service. Traffic on each source
    port is mirrored into a GRE/ERSPAN tunnel to the destination's floating IP.
    The platform router below is only read from, to learn which external network to use. -#}
{%- if tap_mirror_plan.tap_mirrors %}
{# Auto-discover the router base_network attaches to via its router-interface port. -#}
data "openstack_networking_port_v2" "network-forwarding-base-router-port" {
    network_id   = data.{{ tf_resource_network }}.{{ trc.base_network }}.id
    device_owner = "network:router_interface"
}
data "openstack_networking_router_v2" "network-forwarding-platform-router" {
    router_id = data.openstack_networking_port_v2.network-forwarding-base-router-port.device_id
}
data "{{ tf_resource_network }}" "network-forwarding-ext-net" {
    network_id = data.openstack_networking_router_v2.network-forwarding-platform-router.external_network_id
}

{# The destination ports are the only sandbox ports with a floating IP, so they get their own
   security group in place of the topology one: nothing but the hypervisors, which originate the
   mirrored traffic, may reach them. Neutron's default egress-any rules are kept. -#}
resource "{{ tf_secgroup }}" "{{ tap_mirror_plan.secgroup_name }}" {
    name        = "{{ tap_mirror_plan.secgroup_name }}"
    description = "Network forwarding: mirrored traffic from the hypervisors"
}
resource "{{ tf_secgroup_rule }}" "{{ tap_mirror_plan.secgroup_name }}-ingress" {
    direction         = "ingress"
    ethertype         = "IPv4"
    remote_ip_prefix  = "{{ hypervisor_cidr }}"
    security_group_id = {{ tf_secgroup }}.{{ tap_mirror_plan.secgroup_name }}.id
}

{# A router per sandbox: a pool renders the same destination CIDRs for every sandbox, which
   Neutron would reject as overlapping subnets if they all attached to the platform router. -#}
resource "openstack_networking_router_v2" "{{ tap_mirror_plan.router_name }}" {
    name                = "{{ tap_mirror_plan.router_name }}"
    admin_state_up      = "true"
    external_network_id = data.openstack_networking_router_v2.network-forwarding-platform-router.external_network_id
}
{% set ri = tap_mirror_plan.router_interface %}
resource "{{ tf_resource_port }}" "{{ ri.port_name }}" {
    name = "{{ ri.port_name }}"
    network_id = {{ tf_resource_network }}.{{ ri.network_name }}.id
    fixed_ip {
        subnet_id = {{ tf_resource_subnet }}.{{ ri.subnet_name }}.id
        ip_address = "{{ ri.fixed_ip }}"
    }
}
resource "openstack_networking_router_interface_v2" "{{ ri.iface_name }}" {
    router_id = openstack_networking_router_v2.{{ tap_mirror_plan.router_name }}.id
    port_id   = {{ tf_resource_port }}.{{ ri.port_name }}.id
}
{% set fip = tap_mirror_plan.floating_ip %}
resource "openstack_networking_floatingip_v2" "{{ fip.fip_name }}" {
    pool = data.{{ tf_resource_network }}.network-forwarding-ext-net.name
}
resource "openstack_networking_floatingip_associate_v2" "{{ fip.assoc_name }}" {
    floating_ip = openstack_networking_floatingip_v2.{{ fip.fip_name }}.address
    port_id     = {{ tf_resource_port }}.{{ fip.dest_port_name }}.id
    depends_on  = [openstack_networking_router_interface_v2.{{ fip.router_iface_name }}]
}


{% for tm in tap_mirror_plan.tap_mirrors %}
resource "openstack_taas_tap_mirror_v2" "{{ tm.name }}" {
    name        = "{{ tm.name }}"
    mirror_type = "{{ tm.mirror_type }}"
    port_id     = {{ tf_resource_port }}.{{ tm.source_port_name }}.id
    remote_ip   = openstack_networking_floatingip_v2.{{ tm.fip_name }}.address
    directions {
    {%- if tm.tunnel_id_in is not none %}
        in  = {{ tm.tunnel_id_in }}
    {%- endif %}
    {%- if tm.tunnel_id_out is not none %}
        out = {{ tm.tunnel_id_out }}
    {%- endif %}
    }
}
{% endfor -%}
{%- endif -%}

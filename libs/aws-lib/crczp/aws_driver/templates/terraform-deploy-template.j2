{%- macro tf_network(name, cidr_block) %}
resource "aws_vpc" "{{ name }}" {
    cidr_block = "{{ cidr_block }}"
    tags = {
        Name = "{{ name }}"
    }
}

{% include 'security-groups-template.j2' %}

resource "aws_subnet" "{{ name }}-subnet" {
    vpc_id = aws_vpc.{{ name }}.id
    cidr_block = "{{ cidr_block }}"
    availability_zone = "{{ availability_zone }}"
    tags = {
        Name = "{{ name }}-subnet"
    }
}
{%- endmacro -%}

{%- macro tf_port(name, network_name, security_group_name, fixed_ip) %}
resource "aws_network_interface" "{{ name }}" {
    subnet_id = aws_subnet.{{ network_name }}-subnet.id
    {%- if fixed_ip is not none %}
        private_ips = ["{{ fixed_ip }}"]
    {%- endif %}
    security_groups = [aws_security_group.{{ network_name }}-{{ security_group_name }}.id]
    source_dest_check = false
}
{%- endmacro -%}

{%- macro tf_instance(name, ami_id, instance_type, key_pair, link_names, default_ip, volumes) %}
resource "aws_instance" "{{ name }}" {
    ami = {{ ami_id | hcl_string }}
    instance_type = {{ instance_type | hcl_string }}
    tags = {
        Name = "{{ name }}"
    }
    key_name = "{{ key_pair }}"
{%- if volumes %}
    root_block_device {
        volume_size = {{ volumes[0].size }}
    }
{%- for volume in volumes[1:] %}
    ebs_block_device {
        device_name = "/dev/sd{{ 'fghijklmnop'[loop.index0] }}"
        volume_size = {{ volume.size }}
{%- if volume.image is not none %}
        snapshot_id = {{ volume.image | hcl_string }}
{%- endif %}
    }
{%- endfor %}
{%- endif %}

{% for link_name in link_names %}
    network_interface {
        network_interface_id = aws_network_interface.{{ link_name }}.id
        device_index = {{ loop.index0 }}
    }
{% endfor -%}
    user_data = <<EOF
#!/bin/bash
{%- if default_ip is not none %}
sudo ip r del default
sudo ip r add default via {{ default_ip }}
{%- endif %}

EOF
}
{%- endmacro -%}

{%- for network in topology_instance.get_networks() -%}
    {%- set default_gateway = topology_instance.get_network_default_gateway_link(network) -%}
    {%- set network_name = resource_prefix ~ '-' ~ network.name -%}
    {%- set subnet_name = network_name ~ '-subnet' -%}
    {{ tf_network(network_name, network.cidr) }}

    {%- for link in topology_instance.get_network_links(network) -%}
        {%- set link_name = resource_prefix ~ '-' ~ link.name -%}
        {{ tf_port(link_name, network_name, link.security_group, link.ip) }}
    {%- endfor %}
{% endfor -%}

{%- for node in topology_instance.get_nodes_without_man() %}
    {%- set node_name = resource_prefix ~ '-' ~ node.name -%}
    {%- set link_names = topology_instance.get_node_links(node) | map(attribute = 'name')
                         | map('regex_replace', '^', resource_prefix ~ '-') | list -%}
    {%- set default_ip = get_default_route_ip(topology_instance, node) -%}

    {{ tf_instance(node_name, node.base_box.image, node.flavor,
                   key_pair_name_ssh, link_names, default_ip, node.volumes) }}
{% endfor %}

data "aws_vpc" "base-vpc" {
    tags = {
        Name = "{{ base_vpc_name }}"
    }
}

data "aws_subnet" "base-subnet" {
    tags = {
        Name = "{{ base_subnet_name }}"
    }
}

data "aws_security_group" "sandbox-access-sg" {
    vpc_id = data.aws_vpc.base-vpc.id
    name = "sandbox-access-sg"
}

{% set man_out_port_name = resource_prefix ~ '-' ~ trc.man_out_port -%}

resource "aws_network_interface" "{{ man_out_port_name }}" {
    subnet_id = data.aws_subnet.base-subnet.id
    security_groups = [data.aws_security_group.sandbox-access-sg.id]
    source_dest_check = false
}

{% set man = topology_instance.man -%}
{% set man_name = resource_prefix ~ '-' ~ man.name %}
{% set man_links = topology_instance.get_node_links(man) -%}
{% set man_link_names = [man_out_port_name] + (man_links | map(attribute='name')
                         | map('regex_replace', '^', resource_prefix ~ '-') | list) -%}
resource "aws_instance" "{{ man_name }}" {
    ami = "{{ man.base_box.image }}"
    instance_type = "{{ man.flavor }}"
    tags = {
        Name = "{{ man_name }}"
    }
    key_name = "{{ key_pair_name_ssh }}"
{%- for link_name in man_link_names %}
    network_interface {
        network_interface_id = aws_network_interface.{{ link_name }}.id
        device_index = {{ loop.index0 }}
    }
{%- endfor %}
}

{#- Network forwarding (port mirroring) via AWS VPC Traffic Mirroring. Each source ENI is
    mirrored (VXLAN-encapsulated) to the destination ENI target through a filter. -#}
{% if network_forwarding %}
{%- set target_name = resource_prefix ~ '-tmt-' ~ network_forwarding.destination.name %}
{%- set filter_name = resource_prefix ~ '-tmf' %}
{%- set dest_port = resource_prefix ~ '-' ~ network_forwarding.destination.name %}
resource "aws_ec2_traffic_mirror_target" "{{ target_name }}" {
    network_interface_id = aws_network_interface.{{ dest_port }}.id
    depends_on = [aws_instance.{{ resource_prefix }}-{{ network_forwarding.destination.node.name }}]
    tags = {
        Name = "{{ target_name }}"
    }
}

resource "aws_ec2_traffic_mirror_filter" "{{ filter_name }}" {
    network_services = ["amazon-dns"]
    tags = {
        Name = "{{ filter_name }}"
    }
}
{% for direction in traffic_directions %}
resource "aws_ec2_traffic_mirror_filter_rule" "{{ resource_prefix }}-tmfr-{{ direction }}" {
    traffic_mirror_filter_id = aws_ec2_traffic_mirror_filter.{{ filter_name }}.id
    source_cidr_block        = "0.0.0.0/0"
    destination_cidr_block   = "0.0.0.0/0"
    rule_number              = {{ loop.index }}
    rule_action              = "accept"
    traffic_direction        = "{{ direction }}"
}
{% endfor -%}
{% for source in network_forwarding.sources %}
{%- set session_name = resource_prefix ~ '-tms-' ~ loop.index0 %}
resource "aws_ec2_traffic_mirror_session" "{{ session_name }}" {
    network_interface_id     = aws_network_interface.{{ resource_prefix }}-{{ source.name }}.id
    traffic_mirror_target_id = aws_ec2_traffic_mirror_target.{{ target_name }}.id
    traffic_mirror_filter_id = aws_ec2_traffic_mirror_filter.{{ filter_name }}.id
    session_number           = 1
    depends_on               = [aws_instance.{{ resource_prefix }}-{{ source.node.name }}]
    tags = {
        Name = "{{ session_name }}"
    }
}
{% endfor -%}
{% endif -%}
